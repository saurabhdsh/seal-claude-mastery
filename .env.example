NODE_ENV=production
APP_URL=http://52.0.130.62
API_PORT=4000
LOG_LEVEL=info

# PostgreSQL — update with your EC2 DB credentials
DATABASE_URL=postgresql://seal:CHANGE_ME@localhost:5432/seal?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# JWT secrets — generate strong random values (min 32 chars each)
JWT_ACCESS_SECRET=CHANGE_ME_ACCESS_SECRET_MIN_32_CHARS
JWT_REFRESH_SECRET=CHANGE_ME_REFRESH_SECRET_MIN_32_CHARS
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# ── AI Provider ───────────────────────────────────────────────────────────────
# Use AWS Bedrock via the EC2 IAM role (WeaveEC2BedrockRole) — no API keys needed
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# Bedrock model (confirmed working on this EC2)
BEDROCK_ENABLED=true
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0
ANTHROPIC_MODEL=us.anthropic.claude-sonnet-4-5-20250929-v1:0
ANTHROPIC_GENERATION_MODEL=us.anthropic.claude-sonnet-4-5-20250929-v1:0
ANTHROPIC_EVALUATION_MODEL=us.anthropic.claude-sonnet-4-5-20250929-v1:0
ANTHROPIC_CRITIC_MODEL=us.anthropic.claude-sonnet-4-5-20250929-v1:0

# OpenAI (optional fallback)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1

AI_MONTHLY_BUDGET_USD=250
AI_GENERATION_CONCURRENCY=2
AI_MAX_TOKENS=8192

# Cookies
COOKIE_SECURE=true
COOKIE_DOMAIN=

# Seed admin account
SEED_SUPERADMIN_EMAIL=superadmin@seal.local
SEED_SUPERADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD
