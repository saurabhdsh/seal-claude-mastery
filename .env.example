NODE_ENV=production
# Browser origin for CORS. SEAL UI is published on host port 3000 (not SciNova's 5173).
APP_URL=http://20.127.186.132:3000
API_PORT=4000
LOG_LEVEL=info

# PostgreSQL — docker compose overrides this to the postgres service
DATABASE_URL=postgresql://seal:seal@postgres:5432/seal?schema=public

# Redis
REDIS_URL=redis://redis:6379

# JWT secrets — generate strong random values (min 32 chars each)
JWT_ACCESS_SECRET=CHANGE_ME_ACCESS_SECRET_MIN_32_CHARS
JWT_REFRESH_SECRET=CHANGE_ME_REFRESH_SECRET_MIN_32_CHARS
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# ── Cloud + AI Provider ───────────────────────────────────────────────────────
# aws  → Bedrock via EC2 IAM role (legacy)
# azure → Azure OpenAI on rapid-build-dev-server (current)
SEAL_CLOUD=azure
AI_PROVIDER=openai
BEDROCK_ENABLED=false

# Azure OpenAI (required when SEAL_CLOUD=azure). Do not commit the real key.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://exxondemofdr.cognitiveservices.azure.com/openai/v1
# Must be the Azure deployment name, not an EC2 Bedrock model id
OPENAI_MODEL=gpt-5-mini

# Optional Anthropic direct API (unused on Azure by default)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_GENERATION_MODEL=
ANTHROPIC_EVALUATION_MODEL=
ANTHROPIC_CRITIC_MODEL=

# AWS Bedrock (EC2 only — leave off on Azure)
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=

AI_MONTHLY_BUDGET_USD=250
AI_GENERATION_CONCURRENCY=2
AI_MAX_TOKENS=8192

# Cookies — false for plain HTTP on the Azure public IP
COOKIE_SECURE=false
COOKIE_DOMAIN=

# Seed admin account
SEED_SUPERADMIN_EMAIL=superadmin@seal.local
SEED_SUPERADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD
