{
  "name": "seal",
  "private": true,
  "version": "1.0.0",
  "description": "SEAL — Claude Mastery. Enterprise Claude capability assessment platform.",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,magenta \"npm run dev -w server\" \"npm run dev -w client\"",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "db:up": "docker compose up -d postgres redis",
    "db:down": "docker compose down",
    "build": "npm run build -w server && npm run build -w client",
    "test": "npm run test -w server && npm run test -w client",
    "test:e2e": "playwright test",
    "lint": "npm run lint -w server && npm run lint -w client",
    "db:migrate": "npm run db:migrate -w server",
    "db:seed": "npm run db:seed -w server",
    "db:reset": "npm run db:reset -w server",
    "generate:questions": "npm run generate:questions -w server --",
    "generate:level": "npm run generate:level -w server --",
    "validate:question-bank": "npm run validate:question-bank -w server",
    "recalculate:analytics": "npm run recalculate:analytics -w server"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "concurrently": "^9.1.2",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20"
  }
}
