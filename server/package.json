{
  "name": "@seal/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "lint": "tsc -p tsconfig.json --noEmit --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "prisma migrate dev --name init",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx src/seed/index.ts",
    "db:reset": "prisma migrate reset --force",
    "db:generate": "prisma generate",
    "generate:questions": "tsx src/scripts/generateQuestions.ts",
    "generate:level": "tsx src/scripts/generateLevel.ts",
    "validate:anthropic": "tsx src/scripts/validateAnthropic.ts",
    "validate:question-bank": "tsx src/scripts/validateQuestionBank.ts",
    "recalculate:analytics": "tsx src/scripts/recalculateAnalytics.ts"
  },
  "prisma": {
    "seed": "tsx src/seed/index.ts"
  },
  "dependencies": {
    "@anthropic-ai/bedrock-sdk": "^0.32.4",
    "@anthropic-ai/sdk": "^0.39.0",
    "@prisma/client": "^6.1.0",
    "argon2": "^0.41.1",
    "bullmq": "^5.34.5",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.2",
    "jsonwebtoken": "^9.0.2",
    "openai": "^4.104.0",
    "papaparse": "^5.4.1",
    "pdfkit": "^0.19.1",
    "rate-limit-redis": "^4.2.0",
    "uuid": "^11.0.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.2",
    "@types/papaparse": "^5.3.15",
    "@types/pdfkit": "^0.17.6",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.17.0",
    "prisma": "^6.1.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.18.2",
    "vitest": "^2.1.8"
  }
}
